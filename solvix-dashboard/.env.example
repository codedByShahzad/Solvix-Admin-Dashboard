# Solvix Dashboard — copy this file to .env.local and adjust.

# Base URL of the Solvix Express backend (must include /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Show "Preview as Admin / Editor" on the login page, which runs the UI
# on clearly-labelled sample data with no backend calls.
# Set to false for staging/production.
NEXT_PUBLIC_ENABLE_DEMO=true

# Never put integration API keys/secrets in NEXT_PUBLIC_* variables —
# anything prefixed NEXT_PUBLIC_ is shipped to the browser.
